#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &totem_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        // | SW01 | SW02 | SW03 | SW04 | SW05 |   | SW05 | SW04 | SW03 | SW02 | SW01 |
        // | SW06 | SW07 | SW08 | SW09 | SW10 |   | SW10 | SW09 | SW08 | SW07 | SW06 |
        // | SW16 | SW11 | SW12 | SW13 | SW14 | SW15 |   | SW15 | SW14 | SW13 | SW12 | SW11 | SW16 |
        //               | SW17 | SW18 | SW19 |   | SW19 | SW18 | SW17 |
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                            RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    totem_layout: totem_layout {
        compatible = "zmk,physical-layout";
        display-name = "Totem";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        // Totem 38-key layout with column stagger
        // Standard 1u keys positioned in column-staggered layout
        // Order matches matrix_transform map order (row by row)
        keys
            // Row 0 (top row) - 5 keys left, 5 keys right
            = <&key_physical_attrs 100 100    0   0 0 0 0>
            , <&key_physical_attrs 100 100  100   0 0 0 0>
            , <&key_physical_attrs 100 100  200   0 0 0 0>
            , <&key_physical_attrs 100 100  300   0 0 0 0>
            , <&key_physical_attrs 100 100  400   0 0 0 0>
            , <&key_physical_attrs 100 100  700   0 0 0 0>
            , <&key_physical_attrs 100 100  800   0 0 0 0>
            , <&key_physical_attrs 100 100  900   0 0 0 0>
            , <&key_physical_attrs 100 100 1000   0 0 0 0>
            , <&key_physical_attrs 100 100 1100   0 0 0 0>
            // Row 1 (home row) - 5 keys left, 5 keys right
            , <&key_physical_attrs 100 100    0 100 0 0 0>
            , <&key_physical_attrs 100 100  100 100 0 0 0>
            , <&key_physical_attrs 100 100  200 100 0 0 0>
            , <&key_physical_attrs 100 100  300 100 0 0 0>
            , <&key_physical_attrs 100 100  400 100 0 0 0>
            , <&key_physical_attrs 100 100  700 100 0 0 0>
            , <&key_physical_attrs 100 100  800 100 0 0 0>
            , <&key_physical_attrs 100 100  900 100 0 0 0>
            , <&key_physical_attrs 100 100 1000 100 0 0 0>
            , <&key_physical_attrs 100 100 1100 100 0 0 0>
            // Row 2 (bottom row) - outer pinky + 5 keys left, 5 keys + outer pinky right
            // Note: Outer pinky keys come first in map (RC(3,0) and last (RC(3,9))
            , <&key_physical_attrs 100 100    0 220 0 0 0>
            , <&key_physical_attrs 100 100   20 200 0 0 0>
            , <&key_physical_attrs 100 100  120 200 0 0 0>
            , <&key_physical_attrs 100 100  220 200 0 0 0>
            , <&key_physical_attrs 100 100  320 200 0 0 0>
            , <&key_physical_attrs 100 100  420 200 0 0 0>
            , <&key_physical_attrs 100 100  720 200 0 0 0>
            , <&key_physical_attrs 100 100  820 200 0 0 0>
            , <&key_physical_attrs 100 100  920 200 0 0 0>
            , <&key_physical_attrs 100 100 1020 200 0 0 0>
            , <&key_physical_attrs 100 100 1120 200 0 0 0>
            , <&key_physical_attrs 100 100 1120 220 0 0 0>
            // Thumb cluster - 3 keys left, 3 keys right
            , <&key_physical_attrs 100 100  220 300 0 0 0>
            , <&key_physical_attrs 100 100  320 300 0 0 0>
            , <&key_physical_attrs 100 100  420 300 0 0 0>
            , <&key_physical_attrs 100 100  720 300 0 0 0>
            , <&key_physical_attrs 100 100  820 300 0 0 0>
            , <&key_physical_attrs 100 100  920 300 0 0 0>
            ;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
