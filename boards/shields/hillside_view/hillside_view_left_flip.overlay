 *
 * FLIPPED LAYOUT - LEFT/CENTRAL side
 * - Uses original LEFT PCB (flipped, MCU on top, sockets on opposite side)
 * - Display on central shows: layer, BT status, battery, WPM
 * - Receives Cirque input from right peripheral via BLE relay
 * - Column GPIOs reversed to account for physical flip
 */

#include "hillside_view.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&kscan0 {
    /* Same column order as original LEFT - flipping PCB doesn't change electrical routing */
    col-gpios
        = <&gpio1 7 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        , <&pro_micro 16 GPIO_ACTIVE_HIGH>
        , <&pro_micro 10 GPIO_ACTIVE_HIGH>
        ;
};

&left_encoder {
    status = "okay";
    a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
};

&chosen {
    zephyr,display = &nice_view;
};

/* nice!view display */
&nice_view_spi {
    status = "okay";
};

&nice_view {
    status = "okay";
};

/ {
    /* Virtual input for receiving Cirque data from peripheral */
    glidepoint1: virtual_input {
        compatible = "zmk,virtual-input";
    };

    /* Relay config - receives input from right peripheral */
    input_relay_config_102 {
        compatible = "zmk,split-peripheral-input-relay";
        relay-channel = <102>;
        device = <&glidepoint1>;
    };

    /* Mouse movement config */
    tpad_move_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <0 1 2 3 4 5 6>;

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        scale-multiplier = <1>;
        scale-divisor = <1>;

        y-invert;
    };

    /* Mouse scroll config */
    tpad_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <7>;

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;

        y-invert;

        bindings = <&ib_wheel_scaler 1 8>;
    };

    /* Scroll scaler */
    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };
};
