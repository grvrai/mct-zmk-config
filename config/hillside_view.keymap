#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

// Layer definitions
#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define FUN 4
#define SYS 5

/ {
    behaviors {
        // Swapper for Ctrl+Tab window switching (macOS with swapped GUI/Ctrl)
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;
            ignored-key-positions = <>;
        };

        // Swapper for Ctrl+` window switching within same app (macOS)
        swapper_grave: swapper_grave {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp GRAVE>, <&kt LCTRL>;
            ignored-key-positions = <>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // SYM + FUN held together activates SYS layer
        tri_layer {
            if-layers = <SYM FUN>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE LAYER - QWERTY
        base_layer {
            display-name = "BASE";
            // ----------------------------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |                             |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |                             |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |                             |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                                      |  MUTE  |           |  PP   |
            //                          | GUI | NAV | SPC | LSHFT |  | RSHFT | ENT | SYM | ALT |
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                                        &kp Y  &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G                                        &kp H  &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B                                        &kp N  &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                              &kp C_MUTE               &kp C_PP
                         &kp LGUI  &mo NAV  &kp SPACE  &kp LSHFT      &kp RSHFT  &kp RET  &mo SYM  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // NAV LAYER - Navigation
        nav_layer {
            display-name = "NAV";
            bindings = <
&kp TAB    &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                              &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &kp BSPC
&trans     &swapper_grave &swapper     &trans        &trans        &trans                              &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&kp LSHFT  &trans        &trans        &trans        &trans        &trans                              &kp HOME  &kp PG_DN &kp PG_UP &kp END  &trans  &trans
                                                                          &trans              &trans
                                       &kp LGUI      &trans        &kp SPACE  &trans      &trans  &kp RET  &mo FUN  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // NUM LAYER - Numbers
        num_layer {
            display-name = "NUM";
            bindings = <
&kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                    &kp N6     &kp N7  &kp N8  &kp N9  &kp N0     &kp BSPC
&kp LCTRL  &trans  &trans  &trans  &trans  &trans                                    &kp STAR   &kp N4  &kp N5  &kp N6  &kp PLUS   &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans                                    &kp N0     &kp N1  &kp N2  &kp N3  &kp DOT    &kp EQUAL
                                                  &trans                    &trans
                           &kp LGUI  &trans  &kp SPACE  &trans      &trans  &kp RET  &trans  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // SYM LAYER - Symbols
        sym_layer {
            display-name = "SYM";
            bindings = <
&kp TAB    &kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT                         &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &kp EQUAL  &kp MINUS &kp PLUS  &kp UNDER  &kp GRAVE                         &kp LBKT   &kp LPAR   &kp RPAR   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &kp TILDE  &kp LT    &kp GT    &kp PIPE   &kp BSLH                          &kp LBRC   &kp SQT    &kp DQT    &kp RBRC  &kp PIPE  &kp TILDE
                                                            &trans              &trans
                               &kp LGUI  &mo FUN  &kp SPACE  &trans      &trans  &kp RET  &trans  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // FUN LAYER - Function keys
        fun_layer {
            display-name = "FUN";
            bindings = <
&kp TAB    &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                                &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11
&kp LCTRL  &trans   &trans   &trans   &trans   &trans                                &trans   &trans   &trans   &trans   &trans   &kp F12
&kp LSHFT  &trans   &trans   &trans   &trans   &trans                                &trans   &trans   &trans   &trans   &trans   &trans
                                                      &trans              &trans
                             &kp LGUI  &trans  &kp SPACE  &trans      &trans  &kp RET  &trans  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // SYS LAYER - System controls (activated by SYM + FUN)
        sys_layer {
            display-name = "SYS";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &out OUT_TOG                    &trans  &trans  &trans  &trans  &trans  &bootloader
&trans       &trans        &trans        &trans        &trans        &ext_power EP_TOG               &trans  &trans  &trans  &trans  &trans  &trans
                                                                                  &trans      &trans
                                         &trans        &trans        &trans       &trans      &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Reserved layers for ZMK Studio
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
