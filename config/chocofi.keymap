/*
 * Unified Miryoku-inspired keymap for Chocofi keyboard (36 keys)
 * Uses Miryoku layer structure with urob's num layer
 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 */

#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/36.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/reset.h>

// Layer definitions
#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define FUN 4
#define GAME 5
#define SYS 6

// Key position groups for positional hold-tap (36-key layout)
// Left hand: 15 keys (3 rows × 5 cols)
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
// Right hand: 15 keys (3 rows × 5 cols)
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
// Thumb keys: 6 keys (3 per side)
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/ {
    behaviors {
        // Swapper for Ctrl+Tab window switching (macOS with swapped GUI/Ctrl)
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;
            ignored-key-positions = <1 2 3 4 11 12 13 14 15 25>; // Allow Shift+Tab, navigation keys, and swapper_grave
        };

        // Swapper for Ctrl+` window switching within same app (macOS)
        swapper_grave: swapper_grave {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp GRAVE>, <&kt LCTRL>;
            ignored-key-positions = <1 2 3 4 11 12 13 14 15 25>; // Allow navigation keys and swapper
        };

        // Home row mods - left hand (urob's timing)
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Home row mods - right hand (urob's timing)
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Tap-dance for numword: tap=numword, double-tap=sticky layer
        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&num_word NUM>, <&sl NUM>;
        };

        // Smart-num: hold=momentary NUM, tap=numword
        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&num_dance>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Combo to access SYS layer (Q + Z on left side)
        combo_sys {
            timeout-ms = <50>;
            key-positions = <0 20>; // Q + Z positions
            bindings = <&mo SYS>;
            layers = <BASE GAME>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // SYM + FUN held together activates SYS layer
        tri_layer {
            if-layers = <SYM FUN>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE LAYER - QWERTY with urob's home row mods (CAGS order)
        base_layer {
            display-name = "BASE";
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // | CTRL| ALT | GUI |SHFT |  G  |   |  H  |SHFT  | GUI | ALT | CTRL|
            // |  A  |  S  |  D  |  F  |     |   |     |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            //             | ESC | NAV | TAB |   | SYM | NUM  | FUN |
            //             |     | RET |     |   | SPC | BSP  | DEL |

            bindings = <
&kp Q          &kp W        &kp E         &kp R         &kp T             &kp Y         &kp U           &kp I         &kp O        &kp P
&hml LCTRL A   &hml LALT S  &hml LGUI D   &hml LSHFT F  &kp G             &kp H         &hmr RSHFT J    &hmr RGUI K   &hmr RALT L  &hmr RCTRL SEMI
&kp Z          &kp X        &kp C         &kp V         &kp B             &kp N         &kp M           &kp COMMA     &kp DOT      &kp FSLH
                            &kp ESC       &lt NAV RET   &kp TAB           &lt SYM SPACE &lt NUM BSPC    &lt FUN DEL
            >;
        };

        // NAV LAYER - Navigation (one-handed left side, ESDF arrows)
        nav_layer {
            display-name = "NAV";
            // -----------------------------------------------------------------------------------------
            // | HOME|PG_DN| UP  |PG_UP| END |   |SW_` |     |     |     |     |
            // | CAPS| LEFT| DOWN|RIGHT| INS |   |SWAP |SHFT | GUI | ALT |CTRL |
            // | UNDO| COPY| CUT |PASTE| REDO|   |S+TAB|     |     |     |     |
            //             |     | NAV |     |   |     |     |     |

            bindings = <
&kp HOME   &kp PG_DN  &kp UP     &kp PG_UP   &kp END       &swapper_grave &trans     &trans    &trans    &trans
&kp CAPS   &kp LEFT   &kp DOWN   &kp RIGHT   &kp INS       &swapper       &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL
&kp K_UNDO &kp K_COPY &kp K_CUT  &kp K_PASTE &kp K_REDO    &kp LS(TAB)    &trans     &trans    &trans    &trans
                      &trans     &mo NAV     &trans        &trans         &trans     &trans
            >;
        };

        // NUM LAYER - Number pad (one-handed right side, activated by right thumb)
        num_layer {
            display-name = "NUM";
            // -----------------------------------------------------------------------------------------
            // |     |     |     |     |     |   |  /  |  7  |  8  |  9  |  -  |
            // | CTRL| ALT | GUI |SHFT |     |   |  *  |  4  |  5  |  6  |  +  |
            // |     |     |     |     |     |   |  0  |  1  |  2  |  3  |  .  |
            //             |     |     |     |   |     | NUM |  =  |

            bindings = <
&trans     &trans    &trans    &trans     &trans    &kp FSLH  &kp N7  &kp N8  &kp N9  &kp MINUS
&kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans    &kp STAR  &kp N4  &kp N5  &kp N6  &kp PLUS
&trans     &trans    &trans    &trans     &trans    &kp N0    &kp N1  &kp N2  &kp N3  &kp DOT
                     &trans    &trans     &trans    &trans    &mo NUM &kp EQUAL
            >;
        };

        // SYM LAYER - Symbols (Traditional number row + Python/JS optimized)
        sym_layer {
            display-name = "SYM";
            // -----------------------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
            // |  =  |  -  |  +  |  _  |  `  |   |  [  |  (  |  )  |  ]  |  :  |
            // |  ~  |  <  |  >  |  |  |  \  |   |  {  |  '  |  "  |  }  |  ;  |
            //             |     |     |     |   | SYM |  /  |  .  |

            bindings = <
&kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR
&kp EQUAL  &kp MINUS &kp PLUS  &kp UNDER &kp GRAVE    &kp LBKT  &kp LPAR  &kp RPAR  &kp RBKT  &kp COLON
&kp TILDE  &kp LT    &kp GT    &kp PIPE  &kp BSLH     &kp LBRC  &kp SQT   &kp DQT   &kp RBRC  &kp SEMI
                     &trans    &trans    &trans       &mo SYM   &kp FSLH  &kp DOT
            >;
        };

        // FUN LAYER - Function keys (Miryoku flipped: right hand function keys)
        fun_layer {
            display-name = "FUN";
            // -----------------------------------------------------------------------------------------
            // |BOOT |     |     |BASE |     |   |PSCR | F7  | F8  | F9  | F12 |
            // | CTRL| ALT | GUI |SHFT |     |   |SLCK | F4  | F5  | F6  | F11 |
            // |     |RALT | FUN |     |     |   |PAUS | F1  | F2  | F3  | F10 |
            //             |     |     |     |   | TAB | SPC | APP |

            bindings = <
&bootloader &none     &none      &to BASE   &none     &kp PSCRN        &kp F7     &kp F8     &kp F9     &kp F12
&kp LCTRL   &kp LALT  &kp LGUI   &kp LSHFT  &none     &kp SLCK         &kp F4     &kp F5     &kp F6     &kp F11
&none       &kp RALT  &mo FUN    &none      &none     &kp PAUSE_BREAK  &kp F1     &kp F2     &kp F3     &kp F10
                      &trans     &none      &none     &kp TAB          &kp SPACE  &kp K_APP
            >;
        };

        // GAME LAYER - Gaming mode (no home row mods, instant key response)
        game_layer {
            display-name = "GAME";
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            //             | CTRL| SPC | ALT |   | SYM | NUM  | FUN |
            // Q+Z combo opens SYS layer to toggle back to BASE

            bindings = <
&kp Q      &kp W      &kp E      &kp R      &kp T         &kp Y         &kp U        &kp I         &kp O        &kp P
&kp A      &kp S      &kp D      &kp F      &kp G         &kp H         &kp J        &kp K         &kp L        &kp SEMI
&kp Z      &kp X      &kp C      &kp V      &kp B         &kp N         &kp M        &kp COMMA     &kp DOT      &kp FSLH
                      &kp LCTRL  &kp SPACE  &kp LALT      &lt SYM SPACE &lt NUM BSPC &lt FUN DEL
            >;
        };

        // SYS LAYER - System (includes GAME mode toggle)
        sys_layer {
            display-name = "SYS";
            // -----------------------------------------------------------------------------------------
            // |BTCLR| BT0 | BT1 | BT2 | BT3 |   | RGB | RGB | RGB | RGB | RGB |
            // |BOOT |     |     |GAME | OUT |   | TOG | HUI | SAI | BRI | EFF |
            // |     |     |     |BASE |EP_TOG|  | OUT | BT0 | BT1 | BT2 |BOOT |
            //             |     |     |     |   |     |     |     |

            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       &bt BT_SEL 4  &trans          &trans          &trans          &trans
&bootloader  &trans        &trans        &to GAME      &out OUT_TOG       &out OUT_TOG  &trans          &trans          &trans          &trans
&trans       &trans        &trans        &to BASE      &ext_power EP_TOG  &out OUT_TOG  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bootloader
                           &trans        &trans        &trans             &trans        &trans          &trans
            >;
        };

        // Reserved layers for ZMK Studio
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
