/*
 * KLOR 42-key keymap with Miryoku-inspired layout
 * Based on Hillside View layout adapted for Klor
 * Copyright (c) 2022 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 */

#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/klor.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/reset.h>

// Layer definitions
#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define FUN 4
#define GAME 5
#define SYS 6

// Key position groups for positional hold-tap (42-key Klor layout)
// See: zmk-helpers/include/zmk-helpers/key-labels/klor.h
// Left hand: 17 keys (top 5 + middle 6 + bottom 6)
#define KEYS_L LT4 LT3 LT2 LT1 LT0 LM5 LM4 LM3 LM2 LM1 LM0 LB5 LB4 LB3 LB2 LB1 LB0
// Right hand: 17 keys (top 5 + middle 6 + bottom 6)
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
// Thumb keys: 8 keys (4 per side)
#define THUMBS LH3 LH2 LH1 LH0 RH0 RH1 RH2 RH3

/ {
    behaviors {
        // Swapper for Ctrl+Tab window switching (macOS with swapped GUI/Ctrl)
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;
            ignored-key-positions = <LT3 LT2 LT1 LT0 LM3 LM2 LM1 LM0 LB2>; // Allow Shift+Tab, navigation keys
        };

        // Swapper for Ctrl+` window switching within same app (macOS)
        swapper_grave: swapper_grave {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LCTRL>, <&kp GRAVE>, <&kt LCTRL>;
            ignored-key-positions = <LT3 LT2 LT1 LT0 LM3 LM2 LM1 LM0 LB2>; // Allow navigation keys
        };

        // Home row mods - left hand (urob's timing)
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Home row mods - right hand (urob's timing)
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Tap-dance for numword: tap=numword, double-tap=sticky layer
        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&num_word NUM>, <&sl NUM>;
        };

        // Smart-num: hold=momentary NUM, tap=numword
        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&num_dance>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Combo to access SYS layer (outer pinky keys: TAB + LSHFT)
        combo_sys {
            timeout-ms = <50>;
            key-positions = <LM5 LB5>; // TAB + LSHFT positions
            bindings = <&mo SYS>;
            layers = <BASE GAME>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // SYM + FUN held together activates SYS layer
        tri_layer {
            if-layers = <SYM FUN>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE LAYER - QWERTY with urob's home row mods (CAGS order)
        base_layer {
            display-name = "BASE";
            /* KLOR 42-key layout
             *           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             *           │    Q    │    W    │    E    │    R    │    T    │                    │    Y    │    U    │    I    │    O    │    P    │
             * ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
             * │   TAB   │  CTRL/A │  ALT/S  │  GUI/D  │ SHFT/F  │    G    │                    │    H    │ SHFT/J  │  GUI/K  │  ALT/L  │ CTRL/;  │    '    │
             * ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
             * │  SHIFT  │    Z    │    X    │    C    │    V    │    B    ││  MUTE  ││ PL/PS  ││    N    │    M    │    ,    │    .    │    /    │  SHIFT  │
             * └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
             *                               │   ESC   │ NAV/RET │   TAB   │  LSHFT  ││  RSHFT  │ SYM/SPC │ NUM/BSP │ FUN/DEL │
             *                               └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘
             */
            bindings = <
                     &kp Q          &kp W        &kp E         &kp R         &kp T                                           &kp Y         &kp U            &kp I         &kp O        &kp P
            &kp TAB  &hml LCTRL A   &hml LALT S  &hml LGUI D   &hml LSHFT F  &kp G                                           &kp H         &hmr RSHFT J     &hmr RGUI K   &hmr RALT L  &hmr RCTRL SEMI  &kp SQT
            &kp LSHFT &kp Z         &kp X        &kp C         &kp V         &kp B     &kp C_MUTE          &kp C_PP           &kp N         &kp M            &kp COMMA     &kp DOT      &kp FSLH         &kp RSHFT
                                                 &kp ESC       &lt NAV RET   &kp TAB   &kp LSHFT           &kp RSHFT          &lt SYM SPACE &smart_num NUM 0 &lt FUN DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // NAV LAYER - Navigation (one-handed LEFT side, ESDF arrows)
        nav_layer {
            display-name = "NAV";
            bindings = <
                     &kp HOME   &kp PG_DN  &kp UP     &kp PG_UP   &kp END                                           &swapper_grave &trans     &trans    &trans    &trans
            &trans   &kp CAPS   &kp LEFT   &kp DOWN   &kp RIGHT   &kp INS                                           &swapper       &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &trans
            &bootloader &kp K_UNDO &kp K_COPY &kp K_CUT &kp K_PASTE &kp K_REDO &trans          &trans                &kp LS(TAB)    &trans     &trans    &trans    &trans     &trans
                                             &trans     &mo NAV    &trans     &trans           &trans                &trans         &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // NUM LAYER - Number pad (one-handed right side, urob's design)
        num_layer {
            display-name = "NUM";
            bindings = <
                     &trans     &trans    &trans    &trans     &trans                                             &kp FSLH  &kp N7  &kp N8  &kp N9  &kp MINUS
            &trans   &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans                                             &kp STAR  &kp N4  &kp N5  &kp N6  &kp PLUS    &trans
            &trans   &trans     &trans    &trans    &trans     &trans     &trans          &trans                  &kp N0    &kp N1  &kp N2  &kp N3  &kp DOT     &bootloader
                                          &trans    &trans     &trans     &trans          &trans                  &trans    &mo NUM &kp EQUAL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // SYM LAYER - Symbols (Traditional number row + Python/JS optimized)
        sym_layer {
            display-name = "SYM";
            bindings = <
                     &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                                            &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR
            &trans   &kp EQUAL  &kp MINUS &kp PLUS  &kp UNDER &kp GRAVE                                            &kp LBKT  &kp LPAR  &kp RPAR  &kp RBKT  &kp COLON  &kp DQT
            &trans   &kp TILDE  &kp LT    &kp GT    &kp PIPE  &kp BSLH   &trans          &trans                    &kp LBRC  &kp SQT   &kp COMMA &kp RBRC  &kp SEMI   &trans
                                          &trans    &mo FUN   &trans     &trans          &trans                    &mo SYM   &kp FSLH  &kp DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // FUN LAYER - Function keys (Miryoku flipped: right hand function keys)
        fun_layer {
            display-name = "FUN";
            bindings = <
                       &bootloader &none     &none      &to BASE   &none                                              &kp PSCRN        &kp F7     &kp F8     &kp F9     &kp F12
            &trans     &kp LCTRL   &kp LALT  &kp LGUI   &kp LSHFT  &none                                              &kp SLCK         &kp F4     &kp F5     &kp F6     &kp F11    &trans
            &trans     &none       &kp RALT  &mo FUN    &none      &none      &trans          &trans                  &kp PAUSE_BREAK  &kp F1     &kp F2     &kp F3     &kp F10    &trans
                                             &trans     &none      &none      &trans          &trans                  &kp TAB          &kp SPACE  &kp K_APP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // GAME LAYER - Gaming mode (no home row mods, instant key response)
        game_layer {
            display-name = "GAME";
            // TAB+SHIFT combo opens SYS layer to toggle back to BASE
            bindings = <
                     &kp Q      &kp W      &kp E      &kp R      &kp T                                               &kp Y         &kp U            &kp I         &kp O        &kp P
            &kp TAB  &kp A      &kp S      &kp D      &kp F      &kp G                                               &kp H         &kp J            &kp K         &kp L        &kp SEMI   &kp SQT
            &kp LSHFT &kp Z     &kp X      &kp C      &kp V      &kp B      &kp C_MUTE          &kp C_PP             &kp N         &kp M            &kp COMMA     &kp DOT      &kp FSLH   &kp RSHFT
                                           &kp LCTRL  &kp SPACE  &kp LALT   &kp LSHFT           &kp RSHFT            &lt SYM SPACE &smart_num NUM 0 &lt FUN DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // SYS LAYER - System controls (activated by SYM + FUN or TAB+SHIFT combo)
        sys_layer {
            display-name = "SYS";
            bindings = <
                       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                                    &bt BT_SEL 4  &trans          &trans          &trans          &trans
            &trans     &bootloader  &trans        &trans        &to GAME      &out OUT_TOG                                    &out OUT_TOG  &trans          &trans          &trans          &trans       &trans
            &trans     &trans       &trans        &trans        &to BASE      &ext_power EP_TOG  &trans       &trans          &out OUT_TOG  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3 &bootloader
                                                  &trans        &trans        &trans             &trans       &trans          &trans        &trans          &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Reserved layers for ZMK Studio
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
