/*
 * Unified Miryoku-inspired keymap for Sofle keyboard
 * Uses Miryoku layer structure with urob's num layer and timing
 * Matches Corne keymap layout
 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 */

#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/sofle.h>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

// Layer definitions
#define BASE 0
#define NAV 1
#define MOUSE 2
#define MEDIA 3
#define NUM 4
#define SYM 5
#define FUN 6
#define SYS 7

// Key position groups for positional hold-tap
#define KEYS_L LN0 LN1 LN2 LN3 LN4 LN5 LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // Left hand
#define KEYS_R RN0 RN1 RN2 RN3 RN4 RN5 RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // Right hand
#define THUMBS LH0 LH1 LH2 LH3 LH4 RH0 RH1 RH2 RH3 RH4  // Thumb keys

/ {
    behaviors {
        // Home row mods - left hand (urob's timing)
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Home row mods - right hand (urob's timing)
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Tap-dance for numword: tap=numword, double-tap=sticky layer
        num_dance: num_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&num_word NUM>, <&sl NUM>;
        };

        // Smart-num: hold=momentary NUM, tap=numword
        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&num_dance>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer_access {
            if-layers = <NAV MOUSE>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE LAYER - QWERTY with urob's home row mods
        base_layer {
            display-name = "BASE";
            // ------------------------------------------------------------------------------------------------------------
            // |  `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // | ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // | TAB  | GUI | ALT | CTRL | SHFT |  G   |                   |  H   | SHFT  | CTRL  | ALT  |  GUI  |   '   |
            // |      |  A  |  S  |  D   |  F   |      |                   |      |  J    |  K    |  L   |   ;   |       |
            // | SHFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |  PP   |  N   |  M    |  ,    |  .   |   /   | SHFT  |
            //                    | CTRL |MEDI  | NAV  | MOUS   |  | SYM   | NUM  |  FUN  | RALT |
            //                    |      | ESC  | SPC  |  TAB   |  |  RET  | BSP  |  DEL  |      |

            bindings = <
&kp GRAVE  &kp N1        &kp N2       &kp N3        &kp N4        &kp N5                                  &kp N6      &kp N7           &kp N8        &kp N9       &kp N0           &kp MINUS
&kp ESC    &kp Q         &kp W        &kp E         &kp R         &kp T                                   &kp Y       &kp U            &kp I         &kp O        &kp P            &kp BSPC
&kp TAB    &hml LGUI A   &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G                                   &kp H       &hmr RSHFT J     &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI   &kp SQT
&kp LSHFT  &kp Z         &kp X        &kp C         &kp V         &kp B       &kp C_MUTE    &kp C_PP      &kp N       &kp M            &kp COMMA     &kp DOT      &kp FSLH         &kp RSHFT
                         &kp LCTRL    &lt MEDIA ESC &lt NAV SPACE &lt MOUSE TAB             &lt SYM RET   &lt NUM BSPC &lt FUN DEL     &kp RALT      &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        // NAV LAYER - Navigation (right hand IJKL navigation)
        nav_layer {
            display-name = "NAV";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |      |BOOT |     |      | BASE |      |                   | INS  | HOME |Ppgdn |PgUP  |  END  |       |
            // |      | GUI | ALT | CTRL | SHFT |      |                   | CAPS | LEFT | DOWN |  UP  | RIGHT |       |
            // |      |     |RALT |  NUM |  NAV |      |       |  |        | REDO |PASTE | COPY | CUT  | UNDO  |       |
            //                    |      |      |      |       |  |        |      |      |      |

            bindings = <
&trans  &trans        &trans     &trans     &trans     &trans                       &trans     &trans       &trans      &trans    &trans      &trans
&trans  &bootloader   &trans     &trans     &to BASE   &trans                       &kp INS    &kp HOME     &kp PG_DN   &kp PG_UP &kp END     &trans
&trans  &kp LGUI      &kp LALT   &kp LCTRL  &kp LSHFT  &trans                       &kp CAPS   &kp LEFT     &kp DOWN    &kp UP    &kp RIGHT   &trans
&trans  &trans        &kp RALT   &mo NUM    &mo NAV    &trans  &trans      &trans   &kp K_REDO &kp K_PASTE  &kp K_COPY  &kp K_CUT &kp K_UNDO  &trans
                      &trans     &trans     &trans     &trans              &trans   &none      &none        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // MOUSE LAYER - Mouse keys
        mouse_layer {
            display-name = "MOUS";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |      |BOOT |     |      | BASE |      |                   |      |      |      |      |       |       |
            // |      | GUI | ALT | CTRL | SHFT |      |                   |      | SHFT | CTRL | ALT  |  GUI  |       |
            // |      |     |RALT |  SYM | MOUS |      |       |  |        | REDO |PASTE | COPY | CUT  | UNDO  |       |
            //                    |      |      |      |       |  |        |      |      |      |

            bindings = <
&trans  &trans        &trans     &trans     &trans     &trans                       &trans     &trans       &trans      &trans    &trans    &trans
&trans  &bootloader   &trans     &trans     &to BASE   &trans                       &trans     &trans       &trans      &trans    &trans    &trans
&trans  &kp LGUI      &kp LALT   &kp LCTRL  &kp LSHFT  &trans                       &trans     &kp RSHFT    &kp RCTRL   &kp RALT  &kp RGUI  &trans
&trans  &trans        &kp RALT   &mo SYM    &mo MOUSE  &trans  &trans      &trans   &kp K_REDO &kp K_PASTE  &kp K_COPY  &kp K_CUT &kp K_UNDO &trans
                      &trans     &trans     &trans     &trans              &trans   &none      &none        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // MEDIA LAYER - Media controls and system
        media_layer {
            display-name = "MEDI";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |      |BOOT |     |      | BASE |      |                   | RGB  | RGB  | RGB  | RGB  |  RGB  |       |
            // |      | GUI | ALT | CTRL | SHFT |      |                   |  TOG | HUI  | SAI  | BRI  |  EFF  |       |
            // |      |     |RALT |  FUN | MEDI |      |       |  |        |  OUT | BT0  | BT1  | BT2  |  BT3  |       |
            //                    |      |      |      |       |  |        | MUTE | VOL- | VOL+ |

            bindings = <
&trans  &trans        &trans     &trans     &trans     &trans                       &trans              &trans          &trans          &trans          &trans          &trans
&trans  &bootloader   &trans     &trans     &to BASE   &trans                       &rgb_ug RGB_TOG     &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_EFF &trans
&trans  &kp LGUI      &kp LALT   &kp LCTRL  &kp LSHFT  &trans                       &ext_power EP_TOG   &kp C_PREV      &kp C_NEXT      &kp C_PP        &kp C_STOP      &trans
&trans  &trans        &kp RALT   &mo FUN    &mo MEDIA  &trans  &trans      &trans   &out OUT_TOG        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &trans
                      &trans     &trans     &trans     &trans              &trans   &kp C_MUTE          &kp C_VOL_DN    &kp C_VOL_UP
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        // NUM LAYER - Number pad (urob's layout)
        num_layer {
            display-name = "NUM";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |   =  |  +  |  -  |  *   |  /   |      |                   |  /   |  7   |  8   |  9   |   -   |       |
            // |   =  |  +  | GUI | ALT  | CTRL | SHFT |                   |      |  4   |  5   |  6   |   +   |       |
            // |      |     |     |  {   |  }   |      |       |  |        |  0   |  1   |  2   |  3   |   .   |       |
            //                    |      |      |      |       |  |        |      |  0   |      |

            bindings = <
&trans     &trans    &trans     &trans     &trans     &trans                       &trans    &trans  &trans  &trans  &trans     &trans
&kp EQUAL  &kp PLUS  &kp MINUS  &kp STAR   &kp FSLH   &trans                       &kp FSLH  &kp N7  &kp N8  &kp N9  &kp MINUS  &trans
&kp EQUAL  &kp PLUS  &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT                    &trans    &kp N4  &kp N5  &kp N6  &kp PLUS   &trans
&trans     &trans    &trans     &kp LBRC   &kp RBRC   &trans     &trans    &trans  &kp N0    &kp N1  &kp N2  &kp N3  &kp DOT    &trans
                     &trans     &trans     &trans     &trans               &trans  &trans    &kp N0  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // SYM LAYER - Symbols (right hand symbols)
        sym_layer {
            display-name = "SYM";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |      |BOOT |     |      | BASE |      |                   |  {   |  &   |  *   |  (   |   }   |       |
            // |      | GUI | ALT | CTRL | SHFT |      |                   |  +   |  $   |  %   |  ^   |   :   |       |
            // |      |     |RALT |  SYM | MOUS |      |       |  |        |  |   |  !   |  @   |  #   |   ~   |       |
            //                    |      |      |      |       |  |        |  _   |  (   |  )   |

            bindings = <
&trans  &trans        &trans     &trans     &trans     &trans                       &trans     &trans    &trans   &trans    &trans     &trans
&trans  &bootloader   &trans     &trans     &to BASE   &trans                       &kp LBRC   &kp AMPS  &kp ASTRK &kp LPAR  &kp RBRC   &trans
&trans  &kp LGUI      &kp LALT   &kp LCTRL  &kp LSHFT  &trans                       &kp PLUS   &kp DLLR  &kp PRCNT &kp CARET &kp COLON  &trans
&trans  &trans        &kp RALT   &mo SYM    &mo MOUSE  &trans  &trans      &trans   &kp PIPE   &kp EXCL  &kp AT    &kp HASH  &kp TILDE  &trans
                      &trans     &trans     &none      &none                &trans   &kp UNDER  &kp LPAR  &kp RPAR
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // FUN LAYER - Function keys (right hand function keys)
        fun_layer {
            display-name = "FUN";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |      |BOOT |     |      | BASE |      |                   | PSCR |  F7  |  F8  |  F9  |  F12  |       |
            // |      | GUI | ALT | CTRL | SHFT |      |                   | SLCK |  F4  |  F5  |  F6  |  F11  |       |
            // |      |     |RALT |  FUN | MEDI |      |       |  |        | PAUS |  F1  |  F2  |  F3  |  F10  |       |
            //                    |      |      |      |       |  |        |  TAB | SPC  | APP  |

            bindings = <
&trans  &trans        &trans     &trans     &trans     &trans                       &trans           &trans     &trans     &trans     &trans   &trans
&trans  &bootloader   &trans     &trans     &to BASE   &trans                       &kp PSCRN        &kp F7     &kp F8     &kp F9     &kp F12  &trans
&trans  &kp LGUI      &kp LALT   &kp LCTRL  &kp LSHFT  &trans                       &kp SLCK         &kp F4     &kp F5     &kp F6     &kp F11  &trans
&trans  &trans        &kp RALT   &mo FUN    &mo MEDIA  &trans  &trans      &trans   &kp PAUSE_BREAK  &kp F1     &kp F2     &kp F3     &kp F10  &trans
                      &trans     &trans     &none      &none                &trans   &kp TAB          &kp SPACE  &kp K_APP
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // SYS LAYER - System (conditional: NAV + MOUSE)
        sys_layer {
            display-name = "SYS";
            // ------------------------------------------------------------------------------------------------------------
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |BTCLR | BT0 | BT1 |  BT2 | BT3  | BT4  |                   |      |      |      |      |       |       |
            // |      |     |     |      |      |      |                   |      |      |      |      |       |       |
            // |BOOT  |     |     |      |      |      |       |  |        |      |      |      |      |       | BOOT  |
            //                    |      |      |      |       |  |        |      |      |      |

            bindings = <
&trans       &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &bootloader
                           &trans        &trans        &trans        &trans                  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
